{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/start",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/sanity-cdn/:path*",
      "destination": "https://cdn.sanity.io/:path*"
    },
    {
      "source": "/",
      "destination": "/start/index.html"
    },
    {
      "source": "/start",
      "destination": "/start/index.html"
    },
    {
      "source": "/start/",
      "destination": "/start/index.html"
    },
    {
      "source": "/start/:path*",
      "destination": "/start/:path*"
    },
    {
      "source": "/portfolio",
      "destination": "/index.html"
    },
    {
      "source": "/portfolio/",
      "destination": "/index.html"
    },
    {
      "source": "/portfolio/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/((?!assets/|textures/|images/|fonts/|sounds/|videos/|cursors/|start/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/textures/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
